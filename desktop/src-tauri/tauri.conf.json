{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "取り付け工程表",
  "identifier": "dev.torituke-koutei.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node ../build.mjs",
    "beforeDevCommand": {
      "script": "node ../build.mjs",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "取り付け工程表",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "iori0311",
    "copyright": "Copyright (c) 2026 iori0311",
    "homepage": "https://github.com/iori0311/koutei",
    "category": "Productivity",
    "shortDescription": "取り付け工程表",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "licenses/codex-LICENSE.txt": "licenses/codex-LICENSE.txt",
      "licenses/codex-NOTICE.txt": "licenses/codex-NOTICE.txt"
    }
  }
}
